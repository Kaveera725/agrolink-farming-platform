# DELIVERY_BASE_KM=50
# DELIVERY_EXTRA_PER_KM=60
# MAX_DELIVERY_KM=300
# ROUTE_FALLBACK_FACTOR=1.3
# ROUTES_API_TIMEOUT_SECONDS=5

# Payment Gateway Configuration (Optional, defaults provided in config.py)
PAYMENT_GATEWAY_SECRET=
PAYMENT_SESSION_MINUTES=
MAX_PAYMENT_ATTEMPTS_PER_ORDER=


